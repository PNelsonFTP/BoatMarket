generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id              String @id @default("local")
  workspaceVersion Int @default(0)
  referencePoints Json @default("[]")
  favorites Favorite[]
  notes Note[]
  searches SavedSearch[]
  rules RuleSet[]
  alerts Alert[]
}
model BoatGroup {
  id String @id @default(cuid())
  reason String
  createdAt DateTime @default(now())
  listings Listing[]
  anchorListingId String?
  mergedIntoId String?
  retiredAt DateTime?
}
model Seller {
  id String @id @default(cuid())
  key String @unique
  name String
  type String?
  data Json @default("{}")
  listings Listing[]
}
model Listing {
  id String @id
  source String
  sourceListingId String
  sourceUrl String
  title String
  make String?
  model String?
  year Int?
  price Float?
  identityHin String?
  vesselId String?
  length Float?
  horsepower Float?
  lat Float?
  lng Float?
  state String?
  status String @default("active")
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  removedAt DateTime?
  data Json
  rawPayload Json?
  confidence Json @default("{}")
  isSample Boolean @default(false)
  groupId String?
  group BoatGroup? @relation(fields:[groupId],references:[id],onDelete:SetNull)
  sellerId String?
  seller Seller? @relation(fields:[sellerId],references:[id],onDelete:SetNull)
  engines Engine[]
  prices PriceHistory[]
  favorites Favorite[]
  notes Note[]
  duplicateDecisionsLeft DuplicateDecision[] @relation("DuplicateDecisionLeft")
  duplicateDecisionsRight DuplicateDecision[] @relation("DuplicateDecisionRight")
  @@unique([source,sourceListingId])
  @@index([status,price])
  @@index([source,lastSeenAt])
  @@index([make,model,year])
  @@index([identityHin])
  @@index([vesselId])
}
model DuplicateDecision {
  id String @id @default(cuid())
  leftId String
  rightId String
  decision String
  leftFingerprint String?
  rightFingerprint String?
  evidence Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  left Listing @relation("DuplicateDecisionLeft",fields:[leftId],references:[id],onDelete:Cascade)
  right Listing @relation("DuplicateDecisionRight",fields:[rightId],references:[id],onDelete:Cascade)
  @@unique([leftId,rightId])
}
model Engine {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
  make String?
  model String?
  year Int?
  hp Float?
  hours Float?
  @@index([listingId])
}
model PriceHistory {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
  price Float
  at DateTime @default(now())
  @@index([listingId,at])
}
model SearchArea {
  id String @id
  name String
  config Json
}
model SavedSearch {
  id String @id
  userId String @default("local")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  filters Json
  cadence String @default("off")
  channels Json @default("[\"in-app\"]")
  digest Boolean @default(true)
  eventTypes Json @default("[\"new-match\",\"price-change\",\"status-change\"]")
  lastCheckedAt DateTime?
  matchState Json @default("{}")
  createdAt DateTime @default(now())
  @@index([userId])
}
model Favorite {
  userId String
  listingId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([userId,listingId])
}
model Note {
  userId String
  listingId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
  text String
  updatedAt DateTime @updatedAt
  @@id([userId,listingId])
}
model RuleSet {
  id String @id
  userId String @default("local")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  config Json
  @@index([userId])
}
model Alert {
  id String @id @default(cuid())
  userId String @default("local")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  body String
  listingIds Json
  read Boolean @default(false)
  createdAt DateTime @default(now())
  deliveries Json @default("[]")
  deliveredAt DateTime?
  deliveryError String?
  attempts Int @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  deliveryHistory Json @default("[]")
  eventDetails Json @default("[]")
  @@index([deliveredAt,nextAttemptAt])
  @@index([userId,createdAt])
}
model IngestRun {
  id String @id @default(cuid())
  source String
  area String
  startedAt DateTime @default(now())
  completedAt DateTime?
  status String @default("running")
  found Int @default(0)
  new Int @default(0)
  updated Int @default(0)
  removed Int @default(0)
  errors Json @default("[]")
}
model GeocodeCache {
  query String @id
  results Json
  createdAt DateTime @default(now())
}
model JobLock {
  key String @id
  owner String
  expiresAt DateTime
}

model VesselEvent {
  id String @id @default(cuid())
  vesselId String
  listingId String?
  kind String
  at DateTime @default(now())
  data Json @default("{}")
  @@index([vesselId,at])
  @@index([listingId,at])
}
model LocationOverride {
  listingId String @id
  data Json
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}
model LocationOverrideEvent {
  id String @id @default(cuid())
  listingId String
  action String
  data Json
  createdAt DateTime @default(now())
  @@index([listingId,createdAt])
}
model RouteCache {
  key String @id
  data Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}
model ProviderState {
  key String @id
  nextRequestAt DateTime
}
