{
  "name": "boatscout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n web,api,worker -c cyan,green,yellow \"next dev --hostname 127.0.0.1\" \"tsx watch server/index.ts\" \"tsx watch server/worker.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node --import tsx server/index.ts",
    "worker": "node --import tsx server/worker.ts",
    "collect": "node --import tsx server/worker.ts --once",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "export:snapshot": "node --import tsx scripts/export-snapshot.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:audit": "node scripts/generate-sbom.mjs --audit",
    "format": "prettier --write app components lib server tests scripts *.ts *.json",
    "geocode:listings": "node --import tsx scripts/geocode-collected.ts",
    "refresh": "node --import tsx scripts/refresh.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "duplicates:review": "node --import tsx scripts/review-duplicates.ts",
    "configure:lake-holiday": "node --import tsx scripts/configure-lake-holiday.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "cheerio": "^1.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.1",
    "pino": "^9.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.markercluster": "^1.5.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2"
  }
}
